<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_ladder_behav.wdb" id="1">
         <top_modules>
            <top_module name="\$unit_tb_sv " />
            <top_module name="glbl" />
            <top_module name="tb_ladder" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="999,993 ps"></ZoomStartTime>
      <ZoomEndTime time="1,000,002 ps"></ZoomEndTime>
      <Cursor1Time time="1,000,000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="99"></NameColumnWidth>
      <ValueColumnWidth column_width="66"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wvobject type="logic" fp_name="/tb_ladder/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ladder/vif/rst_n">
      <obj_property name="ElementShortName">rst_n</obj_property>
      <obj_property name="ObjectShortName">rst_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ladder/vif/start">
      <obj_property name="ElementShortName">start</obj_property>
      <obj_property name="ObjectShortName">start</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ladder/vif/step_up">
      <obj_property name="ElementShortName">step_up</obj_property>
      <obj_property name="ObjectShortName">step_up</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ladder/vif/broken_rung">
      <obj_property name="ElementShortName">broken_rung</obj_property>
      <obj_property name="ObjectShortName">broken_rung</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_ladder/vif/success">
      <obj_property name="ElementShortName">success</obj_property>
      <obj_property name="ObjectShortName">success</obj_property>
   </wvobject>
</wave_config>
